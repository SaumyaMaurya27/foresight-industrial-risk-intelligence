# ==============================================================================
# Foresight Environment Variables Template
# Copy this file to `backend/.env` and edit key values before launching services.
# ==============================================================================

# FastAPI Server Port
PORT=8000

# Relational Database Connection String
# Local SQLite Path (default for MVP):
DATABASE_URL=sqlite:///./foresight.db
# For production (PostgreSQL example):
# DATABASE_URL=postgresql://user:password@localhost:5432/foresight

# Google Gemini API Credentials
# Request an API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Development
# Target API URL endpoint called by the React/Vite client
VITE_API_URL=http://localhost:8000/api/v1
